# Copia este archivo como .env (NO se sube a GitHub) o escribe estos valores
# en Render > Environment. Nunca pongas contraseñas reales en este archivo.
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
SECRET_KEY=una-frase-larga-y-privada
ADMIN_CODIGO=codigo-para-crear-administradores
# Minutos que dura la reserva (por defecto 5; el proyecto pide de 3 a 5).
# RESERVA_MINUTOS=5
# Solo si el QR muestra localhost: dirección pública de Render, sin "/" al final.
# APP_BASE_URL=https://TU-SERVICIO.onrender.com
